        ✨ Créer mon compte
      </button>
      <button onclick="showProfilePanel('login')" style="width:100%;max-width:320px;padding:16px;background:#1e293b;color:white;border:1px solid #334155;border-radius:16px;font-size:16px;font-weight:700;cursor:pointer;font-family:Montserrat,sans-serif">
        🔑 Se connecter
      </button>
    </div>

    <!-- Register panel -->
    <div id="profile-register" style="display:none;padding:20px">
      <button onclick="showProfilePanel('out')" style="background:none;border:none;color:#64748b;font-size:13px;cursor:pointer;margin-bottom:16px;font-family:Montserrat,sans-serif">← Retour</button>
      <h2 style="font-size:20px;font-weight:900;margin-bottom:20px">Créer mon compte</h2>
      <div style="display:flex;flex-direction:column;gap:12px">
        <div>
          <label style="font-size:11px;color:#64748b;font-weight:700;display:block;margin-bottom:6px">PRÉNOM</label>
          <input id="reg-prenom" placeholder="ex: Sophie" style="width:100%;background:#1e293b;border:1px solid #334155;border-radius:12px;padding:14px;color:white;font-family:Montserrat,sans-serif;font-size:15px;box-sizing:border-box"/>
        </div>
        <div>
          <label style="font-size:11px;color:#64748b;font-weight:700;display:block;margin-bottom:6px">NOM</label>
          <input id="reg-nom" placeholder="ex: Dupont" style="width:100%;background:#1e293b;border:1px solid #334155;border-radius:12px;padding:14px;color:white;font-family:Montserrat,sans-serif;font-size:15px;box-sizing:border-box"/>
        </div>
        <div>
          <label style="font-size:11px;color:#64748b;font-weight:700;display:block;margin-bottom:6px">EMAIL</label>
          <input id="reg-email" type="email" placeholder="ex: sophie@email.com" style="width:100%;background:#1e293b;border:1px solid #334155;border-radius:12px;padding:14px;color:white;font-family:Montserrat,sans-serif;font-size:15px;box-sizing:border-box"/>
        </div>
        <div>
          <label style="font-size:11px;color:#64748b;font-weight:700;display:block;margin-bottom:6px">MOT DE PASSE</label>
          <input id="reg-pwd" type="password" placeholder="••••••••" style="width:100%;background:#1e293b;border:1px solid #334155;border-radius:12px;padding:14px;color:white;font-family:Montserrat,sans-serif;font-size:15px;box-sizing:border-box"/>
        </div>
        <div>
          <label style="font-size:11px;color:#64748b;font-weight:700;display:block;margin-bottom:6px">VILLE</label>
          <input id="reg-ville" placeholder="ex: Fayence" style="width:100%;background:#1e293b;border:1px solid #334155;border-radius:12px;padding:14px;color:white;font-family:Montserrat,sans-serif;font-size:15px;box-sizing:border-box"/>
        </div>
        <p id="reg-client-error" style="color:#ef4444;font-size:12px;display:none;text-align:center"></p>
        <button onclick="doClientRegister()" style="width:100%;padding:16px;background:linear-gradient(135deg,#f97316,#ea580c);color:white;border:none;border-radius:14px;font-size:16px;font-weight:900;cursor:pointer;font-family:Montserrat,sans-serif;margin-top:4px">
          ✨ Créer mon compte
        </button>
      </div>
    </div>

    <!-- Login panel -->
    <div id="profile-login" style="display:none;padding:20px">
      <button onclick="showProfilePanel('out')" style="background:none;border:none;color:#64748b;font-size:13px;cursor:pointer;margin-bottom:16px;font-family:Montserrat,sans-serif">← Retour</button>
      <h2 style="font-size:20px;font-weight:900;margin-bottom:20px">Connexion</h2>
      <div style="display:flex;flex-direction:column;gap:12px">
        <div>
          <label style="font-size:11px;color:#64748b;font-weight:700;display:block;margin-bottom:6px">EMAIL</label>
          <input id="login-email-client" type="email" placeholder="ex: sophie@email.com" style="width:100%;background:#1e293b;border:1px solid #334155;border-radius:12px;padding:14px;color:white;font-family:Montserrat,sans-serif;font-size:15px;box-sizing:border-box"/>
        </div>
        <div>
          <label style="font-size:11px;color:#64748b;font-weight:700;display:block;margin-bottom:6px">MOT DE PASSE</label>
          <input id="login-pwd-client" type="password" placeholder="••••••••" style="width:100%;background:#1e293b;border:1px solid #334155;border-radius:12px;padding:14px;color:white;font-family:Montserrat,sans-serif;font-size:15px;box-sizing:border-box"/>
        </div>
        <p id="login-client-error" style="color:#ef4444;font-size:12px;display:none;text-align:center"></p>
        <button onclick="doClientLogin()" style="width:100%;padding:16px;background:linear-gradient(135deg,#f97316,#ea580c);color:white;border:none;border-radius:14px;font-size:16px;font-weight:900;cursor:pointer;font-family:Montserrat,sans-serif">
          🔑 Se connecter
        </button>
      </div>
    </div>

    <!-- Logged in dashboard -->
    <div id="profile-dashboard" style="display:none">
      <!-- Header avatar -->
      <div style="background:linear-gradient(160deg,#1e293b,#0f172a);padding:28px 20px 20px">
        <div style="display:flex;align-items:center;gap:16px;margin-bottom:20px">
          <div id="profile-avatar-big" style="width:72px;height:72px;border-radius:50%;background:linear-gradient(135deg,#f97316,#10b981);display:flex;align-items:center;justify-content:center;font-size:28px;font-weight:900;color:white;flex-shrink:0;border:3px solid #f97316"></div>
          <div>
            <h2 id="profile-fullname" style="font-size:20px;font-weight:900;margin:0 0 4px"></h2>
            <p id="profile-email-display" style="font-size:13px;color:#64748b;margin:0"></p>
            <p id="profile-ville-display" style="font-size:12px;color:#f97316;margin:4px 0 0">📍 </p>
          </div>
        </div>
        <!-- Stats -->
        <div style="display:grid;grid-template-columns:1fr 1fr 1fr;gap:10px">
          <div style="background:rgba(249,115,22,0.1);border:1px solid rgba(249,115,22,0.2);border-radius:14px;padding:12px;text-align:center">
            <p id="stat-favs" style="font-size:22px;font-weight:900;color:#f97316;margin:0">0</p>
            <p style="font-size:10px;color:#64748b;font-weight:700;margin:2px 0 0">FAVORIS</p>
          </div>
          <div style="background:rgba(16,185,129,0.1);border:1px solid rgba(16,185,129,0.2);border-radius:14px;padding:12px;text-align:center">
            <p id="stat-saves" style="font-size:22px;font-weight:900;color:#34d399;margin:0">0€</p>
            <p style="font-size:10px;color:#64748b;font-weight:700;margin:2px 0 0">ÉCONOMISÉ</p>
          </div>
          <div style="background:rgba(99,102,241,0.1);border:1px solid rgba(99,102,241,0.2);border-radius:14px;padding:12px;text-align:center">
            <p id="stat-co2" style="font-size:22px;font-weight:900;color:#818cf8;margin:0">0kg</p>
            <p style="font-size:10px;color:#64748b;font-weight:700;margin:2px 0 0">CO₂ ÉVITÉ</p>
          </div>
        </div>
      </div>

      <div style="padding:16px">

        <!-- Notifications section -->
        <div style="background:#1e293b;border:1px solid #334155;border-radius:20px;padding:18px;margin-bottom:14px">
          <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:14px">
            <div style="display:flex;align-items:center;gap:10px">
              <span style="font-size:22px">🔔</span>
              <div>
                <p style="font-size:15px;font-weight:900;margin:0">Notifications</p>
                <p style="font-size:11px;color:#64748b;margin:2px 0 0">Alertes produits en temps réel</p>
              </div>
            </div>
            <div id="notif-toggle-wrap">
              <button id="notif-toggle-btn" onclick="toggleNotifications()" style="padding:10px 16px;background:#f97316;color:white;border:none;border-radius:12px;font-size:13px;font-weight:700;cursor:pointer;font-family:Montserrat,sans-serif">
                Activer
              </button>
            </div>
          </div>
          <div id="notif-status-bar" style="display:none;background:rgba(16,185,129,0.1);border:1px solid rgba(16,185,129,0.2);border-radius:10px;padding:10px 12px;display:flex;align-items:center;gap:8px">
            <span style="width:8px;height:8px;border-radius:50%;background:#34d399;flex-shrink:0;animation:pulse 1s infinite"></span>
            <span style="font-size:12px;color:#6ee7b7;font-weight:700">Notifications actives — vous serez alerté des nouvelles offres</span>
          </div>
        </div>

        <!-- Périmètre -->
        <div style="background:#1e293b;border:1px solid #334155;border-radius:20px;padding:18px;margin-bottom:14px">
          <div style="display:flex;align-items:center;gap:10px;margin-bottom:16px">
            <span style="font-size:22px">📍</span>
            <div>
              <p style="font-size:15px;font-weight:900;margin:0">Périmètre de recherche</p>
              <p style="font-size:11px;color:#64748b;margin:2px 0 0">Alertes dans ce rayon autour de vous</p>
            </div>
          </div>
          <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:10px">
            <span style="font-size:14px;font-weight:700">Rayon :</span>
            <span id="radius-display" style="font-size:18px;font-weight:900;color:#f97316">10 km</span>
          </div>
          <input type="range" id="radius-slider" min="1" max="50" value="10" oninput="updateRadius(this.value)"
            style="width:100%;accent-color:#f97316;cursor:pointer"/>
          <div style="display:flex;justify-content:space-between;margin-top:4px">
            <span style="font-size:10px;color:#475569">1 km</span>
            <span style="font-size:10px;color:#475569">50 km</span>
          </div>
          <!-- Zone presets -->
          <div style="display:flex;gap:8px;margin-top:12px;flex-wrap:wrap">
            <button onclick="setRadius(5)" class="radius-preset" style="padding:7px 14px;background:rgba(249,115,22,0.1);border:1px solid rgba(249,115,22,0.3);border-radius:999px;color:#fb923c;font-size:12px;font-weight:700;cursor:pointer;font-family:Montserrat,sans-serif">5 km</button>
            <button onclick="setRadius(10)" class="radius-preset" style="padding:7px 14px;background:rgba(249,115,22,0.2);border:1px solid #f97316;border-radius:999px;color:#f97316;font-size:12px;font-weight:700;cursor:pointer;font-family:Montserrat,sans-serif">10 km</button>
            <button onclick="setRadius(20)" class="radius-preset" style="padding:7px 14px;background:rgba(249,115,22,0.1);border:1px solid rgba(249,115,22,0.3);border-radius:999px;color:#fb923c;font-size:12px;font-weight:700;cursor:pointer;font-family:Montserrat,sans-serif">20 km</button>
            <button onclick="setRadius(50)" class="radius-preset" style="padding:7px 14px;background:rgba(249,115,22,0.1);border:1px solid rgba(249,115,22,0.3);border-radius:999px;color:#fb923c;font-size:12px;font-weight:700;cursor:pointer;font-family:Montserrat,sans-serif">50 km</button>
          </div>
        </div>

        <!-- Catégories favorites -->
        <div style="background:#1e293b;border:1px solid #334155;border-radius:20px;padding:18px;margin-bottom:14px">
          <div style="display:flex;align-items:center;gap:10px;margin-bottom:14px">
            <span style="font-size:22px">❤️</span>
            <div>
              <p style="font-size:15px;font-weight:900;margin:0">Mes catégories</p>
              <p style="font-size:11px;color:#64748b;margin:2px 0 0">Recevoir des alertes pour ces produits</p>
            </div>
          </div>
          <div style="display:flex;flex-wrap:wrap;gap:8px">
            <button onclick="toggleFavCat(this,'viande')" data-cat="viande" class="fav-cat-btn" style="padding:10px 14px;background:rgba(239,68,68,0.1);border:1px solid rgba(239,68,68,0.3);border-radius:12px;color:#fca5a5;font-size:13px;font-weight:700;cursor:pointer;font-family:Montserrat,sans-serif">🥩 Viande</button>
            <button onclick="toggleFavCat(this,'cave')" data-cat="cave" class="fav-cat-btn" style="padding:10px 14px;background:rgba(139,92,246,0.1);border:1px solid rgba(139,92,246,0.3);border-radius:12px;color:#c4b5fd;font-size:13px;font-weight:700;cursor:pointer;font-family:Montserrat,sans-serif">🍷 Cave</button>
            <button onclick="toggleFavCat(this,'primeur')" data-cat="primeur" class="fav-cat-btn" style="padding:10px 14px;background:rgba(16,185,129,0.1);border:1px solid rgba(16,185,129,0.3);border-radius:12px;color:#6ee7b7;font-size:13px;font-weight:700;cursor:pointer;font-family:Montserrat,sans-serif">🥦 Primeur</button>
            <button onclick="toggleFavCat(this,'laitier')" data-cat="laitier" class="fav-cat-btn" style="padding:10px 14px;background:rgba(234,179,8,0.1);border:1px solid rgba(234,179,8,0.3);border-radius:12px;color:#fde68a;font-size:13px;font-weight:700;cursor:pointer;font-family:Montserrat,sans-serif">🧀 Laitier</button>
            <button onclick="toggleFavCat(this,'pret')" data-cat="pret" class="fav-cat-btn" style="padding:10px 14px;background:rgba(59,130,246,0.1);border:1px solid rgba(59,130,246,0.3);border-radius:12px;color:#93c5fd;font-size:13px;font-weight:700;cursor:pointer;font-family:Montserrat,sans-serif">🍱 Prêt</button>
            <button onclick="toggleFavCat(this,'poisson')" data-cat="poisson" class="fav-cat-btn" style="padding:10px 14px;background:rgba(6,182,212,0.1);border:1px solid rgba(6,182,212,0.3);border-radius:12px;color:#67e8f9;font-size:13px;font-weight:700;cursor:pointer;font-family:Montserrat,sans-serif">🐟 Poisson</button>
          </div>
        </div>

        <!-- Produits favoris -->
        <div style="background:#1e293b;border:1px solid #334155;border-radius:20px;padding:18px;margin-bottom:14px">
          <div style="display:flex;align-items:center;gap:10px;margin-bottom:14px">
            <span style="font-size:22px">⭐</span>
            <p style="font-size:15px;font-weight:900;margin:0">Mes produits favoris</p>
          </div>
          <div id="fav-products-list">
            <p style="font-size:13px;color:#475569;text-align:center;padding:12px">Appuyez sur ❤️ sur un deal pour l'ajouter</p>
          </div>
        </div>

        <!-- Déconnexion -->
        <button onclick="logoutClient()" style="width:100%;padding:14px;background:rgba(239,68,68,0.1);border:1px solid rgba(239,68,68,0.2);border-radius:14px;color:#ef4444;font-size:14px;font-weight:700;cursor:pointer;font-family:Montserrat,sans-serif">
          Déconnexion
        </button>
      </div>
    </div>
  </div>

</div>

<!-- TOAST -->
<div class="toast" id="toast"></div>

<!-- BOTTOM NAV -->
<nav class="bottom-nav">
  <button class="nav-btn active" id="nav-feed" onclick="showTab('feed')"><span class="nav-icon">⚡</span><span class="nav-label">Deals</span></button>
  <button class="nav-btn" id="nav-live" onclick="showTab('live')"><span class="nav-icon">🔥</span><span class="nav-label">Live</span><span class="nav-dot"></span></button>
  <button class="nav-btn" id="nav-bimride" onclick="showTab('bimride')"><span class="nav-icon">🚗</span><span class="nav-label">BIM-Ride</span></button>
  <button class="nav-btn" id="nav-b2b" onclick="showTab('b2b')"><span class="nav-icon">📊</span><span class="nav-label">B2B</span></button>
  <button class="nav-btn" id="nav-profile" onclick="showTab('profile')" style="position:relative"><span class="nav-icon">👤</span><span class="nav-label">Compte</span><span id="profile-dot" style="display:none;position:absolute;top:4px;right:14px;width:8px;height:8px;border-radius:50%;background:#34d399"></span></button>
</nav>


<!-- SCRIPTS -->
<script src="https://unpkg.com/@supabase/supabase-js@2"></script>
<script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js" crossorigin=""></script>
<script src="js/config.js"></script>
<script src="js/supabase-client.js"></script>
<script src="js/deals.js"></script>
<script src="js/cart.js"></script>
<script src="js/auth.js"></script>
<script src="js/merchant.js"></script>
<script src="js/notifications.js"></script>
<script src="js/bimride.js"></script>
<script src="js/app.js"></script>
</body>
</html>
