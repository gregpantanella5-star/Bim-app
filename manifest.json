<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no" />
  <title>BIM - Le Cercle Vertueux Alimentaire</title>
  <meta name="theme-color" content="#0f172a" />
  <meta name="description" content="Offres flash anti-gaspi de vos commerçants locaux" />
  <link rel="manifest" href="manifest.json" />
  <link rel="icon" href="logo.png" />
  <link rel="apple-touch-icon" href="logo.png" />
  <link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@400;700;800;900&display=swap" rel="stylesheet" />
  <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" crossorigin="" />
  <link rel="stylesheet" href="css/styles.css" />
</head>
<body>


<div class="content">
  <!-- MERCHANT LOGIN OVERLAY -->
  <div id="merchant-overlay" style="display:none;position:fixed;inset:0;background:rgba(0,0,0,0.85);z-index:500;align-items:center;justify-content:center;padding:24px">
    <div style="background:#1e293b;border:1px solid #334155;border-radius:28px;padding:28px;width:100%;max-width:400px">
      <div style="text-align:center;margin-bottom:24px">
        <div style="width:64px;height:64px;background:linear-gradient(135deg,#f97316,#10b981);border-radius:20px;display:flex;align-items:center;justify-content:center;font-size:28px;margin:0 auto 12px">🏪</div>
        <h2 style="font-size:22px;font-weight:900;margin-bottom:4px">Espace Commerçant</h2>
        <p style="font-size:13px;color:#64748b">Connectez-vous pour publier vos offres</p>
      </div>
      <!-- PANEL: Choisir inscription ou connexion -->
      <div id="login-choice" style="display:flex;flex-direction:column;gap:10px">
        <button onclick="showPanel('register')" style="width:100%;padding:16px;background:#f97316;color:white;border:none;border-radius:14px;font-size:16px;font-weight:900;cursor:pointer;font-family:Montserrat,sans-serif;box-shadow:0 8px 24px rgba(249,115,22,0.3)">
          🏪 Créer mon compte commerçant
        </button>
        <button onclick="showPanel('signin')" style="width:100%;padding:16px;background:#1e293b;color:white;border:1px solid #334155;border-radius:14px;font-size:16px;font-weight:700;cursor:pointer;font-family:Montserrat,sans-serif">
          🔑 Me connecter
        </button>
        <button onclick="closeMerchantOverlay()" style="width:100%;padding:12px;background:none;color:#64748b;border:none;font-size:14px;cursor:pointer;font-family:Montserrat,sans-serif">
          Retour à l'app client
        </button>
      </div>

      <!-- PANEL: Inscription -->
      <div id="register-form" style="display:none;flex-direction:column;gap:12px">
        <button onclick="showPanel('choice')" style="background:none;border:none;color:#64748b;font-size:13px;cursor:pointer;text-align:left;padding:0;font-family:Montserrat,sans-serif">← Retour</button>
        <p style="font-size:13px;font-weight:700;color:#94a3b8;text-align:center;margin-bottom:4px">Nouvelle inscription</p>
        <div>
          <label style="font-size:11px;color:#64748b;font-weight:700;display:block;margin-bottom:6px">NOM DU COMMERCE</label>
          <input id="reg-name" placeholder="ex: Boucherie Martin" style="width:100%;background:#0f172a;border:1px solid #334155;border-radius:12px;padding:14px;color:white;font-family:Montserrat,sans-serif;font-size:15px" />
        </div>
        <div>
          <label style="font-size:11px;color:#64748b;font-weight:700;display:block;margin-bottom:6px">NUMÉRO SIRET (14 chiffres)</label>
          <input id="reg-siret" placeholder="ex: 12345678901234" maxlength="14" type="tel" style="width:100%;background:#0f172a;border:1px solid #334155;border-radius:12px;padding:14px;color:white;font-family:Montserrat,sans-serif;font-size:15px" />
        </div>
        <div>
          <label style="font-size:11px;color:#64748b;font-weight:700;display:block;margin-bottom:6px">CATÉGORIE PRINCIPALE</label>
          <select id="reg-cat" style="width:100%;background:#0f172a;border:1px solid #334155;border-radius:12px;padding:14px;color:white;font-family:Montserrat,sans-serif;font-size:15px">
            <option value="viande">🥩 Boucherie / Charcuterie</option>
            <option value="cave">🍷 Cave / Spiritueux</option>
            <option value="primeur">🥦 Primeur / Fruits & Légumes</option>
            <option value="laitier">🧀 Fromagerie / Laitier</option>
            <option value="pret">🍱 Traiteur / Prêt à manger</option>
            <option value="poisson">🐟 Poisson / Fruits de mer</option>
          </select>
        </div>
        <div>
          <label style="font-size:11px;color:#64748b;font-weight:700;display:block;margin-bottom:6px">CRÉER UN CODE PIN (4 chiffres)</label>
          <div style="display:flex;gap:10px;justify-content:center">
            <input class="pin-input" id="reg-pin-1" maxlength="1" type="tel" oninput="pinNext(this,'reg-pin-2')" style="width:56px;height:56px;background:#0f172a;border:1px solid #334155;border-radius:12px;text-align:center;color:white;font-size:24px;font-weight:900;font-family:Montserrat,sans-serif" />
            <input class="pin-input" id="reg-pin-2" maxlength="1" type="tel" oninput="pinNext(this,'reg-pin-3')" onkeydown="pinBack(event,this,'reg-pin-1')" style="width:56px;height:56px;background:#0f172a;border:1px solid #334155;border-radius:12px;text-align:center;color:white;font-size:24px;font-weight:900;font-family:Montserrat,sans-serif" />
            <input class="pin-input" id="reg-pin-3" maxlength="1" type="tel" oninput="pinNext(this,'reg-pin-4')" onkeydown="pinBack(event,this,'reg-pin-2')" style="width:56px;height:56px;background:#0f172a;border:1px solid #334155;border-radius:12px;text-align:center;color:white;font-size:24px;font-weight:900;font-family:Montserrat,sans-serif" />
            <input class="pin-input" id="reg-pin-4" maxlength="1" type="tel" onkeydown="pinBack(event,this,'reg-pin-3')" style="width:56px;height:56px;background:#0f172a;border:1px solid #334155;border-radius:12px;text-align:center;color:white;font-size:24px;font-weight:900;font-family:Montserrat,sans-serif" />
          </div>
        </div>
        <p id="reg-error" style="color:#ef4444;font-size:12px;text-align:center;display:none"></p>
        <button onclick="doRegister()" style="width:100%;padding:16px;background:#f97316;color:white;border:none;border-radius:14px;font-size:16px;font-weight:900;cursor:pointer;font-family:Montserrat,sans-serif;box-shadow:0 8px 24px rgba(249,115,22,0.3)">
          ✅ Créer mon compte
        </button>
      </div>

      <!-- PANEL: Connexion -->
      <div id="signin-form" style="display:none;flex-direction:column;gap:12px">
        <button onclick="showPanel('choice')" style="background:none;border:none;color:#64748b;font-size:13px;cursor:pointer;text-align:left;padding:0;font-family:Montserrat,sans-serif">← Retour</button>
        <p style="font-size:13px;font-weight:700;color:#94a3b8;text-align:center;margin-bottom:4px">Connexion</p>
        <div>
          <label style="font-size:11px;color:#64748b;font-weight:700;display:block;margin-bottom:6px">NUMÉRO SIRET</label>
          <input id="si-siret" placeholder="14 chiffres" maxlength="14" type="tel" style="width:100%;background:#0f172a;border:1px solid #334155;border-radius:12px;padding:14px;color:white;font-family:Montserrat,sans-serif;font-size:15px" />
        </div>
        <div>
          <label style="font-size:11px;color:#64748b;font-weight:700;display:block;margin-bottom:6px">CODE PIN</label>
          <div style="display:flex;gap:10px;justify-content:center">
            <input class="pin-input" id="si-pin-1" maxlength="1" type="tel" oninput="pinNext(this,'si-pin-2')" style="width:56px;height:56px;background:#0f172a;border:1px solid #334155;border-radius:12px;text-align:center;color:white;font-size:24px;font-weight:900;font-family:Montserrat,sans-serif" />
            <input class="pin-input" id="si-pin-2" maxlength="1" type="tel" oninput="pinNext(this,'si-pin-3')" onkeydown="pinBack(event,this,'si-pin-1')" style="width:56px;height:56px;background:#0f172a;border:1px solid #334155;border-radius:12px;text-align:center;color:white;font-size:24px;font-weight:900;font-family:Montserrat,sans-serif" />
            <input class="pin-input" id="si-pin-3" maxlength="1" type="tel" oninput="pinNext(this,'si-pin-4')" onkeydown="pinBack(event,this,'si-pin-2')" style="width:56px;height:56px;background:#0f172a;border:1px solid #334155;border-radius:12px;text-align:center;color:white;font-size:24px;font-weight:900;font-family:Montserrat,sans-serif" />
            <input class="pin-input" id="si-pin-4" maxlength="1" type="tel" onkeydown="pinBack(event,this,'si-pin-3')" style="width:56px;height:56px;background:#0f172a;border:1px solid #334155;border-radius:12px;text-align:center;color:white;font-size:24px;font-weight:900;font-family:Montserrat,sans-serif" />
          </div>
        </div>
        <p id="si-error" style="color:#ef4444;font-size:12px;text-align:center;display:none"></p>
        <button onclick="doSignIn()" style="width:100%;padding:16px;background:#f97316;color:white;border:none;border-radius:14px;font-size:16px;font-weight:900;cursor:pointer;font-family:Montserrat,sans-serif;box-shadow:0 8px 24px rgba(249,115,22,0.3)">
          🔑 Se connecter
        </button>
        <button onclick="closeMerchantOverlay()" style="width:100%;padding:12px;background:none;color:#64748b;border:none;font-size:14px;cursor:pointer;font-family:Montserrat,sans-serif">
          Retour à l'app client
        </button>
      </div>

      <p id="login-error" style="display:none"></p>
    </div>
  </div>

  <!-- MERCHANT DASHBOARD -->
  <div id="merchant-dashboard" style="display:none;position:fixed;inset:0;background:#0f172a;z-index:400;overflow-y:auto;padding-bottom:80px">
    <div style="padding:16px">
      <!-- Dashboard Header -->
      <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:20px;padding-top:8px">
        <div style="display:flex;align-items:center;gap:12px">
          <div style="width:48px;height:48px;background:linear-gradient(135deg,#f97316,#10b981);border-radius:16px;display:flex;align-items:center;justify-content:center;font-size:22px">🏪</div>
          <div>
            <p id="merchant-name-display" style="font-size:16px;font-weight:900"></p>
            <p id="merchant-siret-display" style="font-size:11px;color:#64748b"></p>
          </div>
        </div>
        <button onclick="logoutMerchant()" style="background:#1e293b;border:1px solid #334155;border-radius:10px;padding:8px 12px;color:#64748b;font-size:12px;font-weight:700;cursor:pointer;font-family:Montserrat,sans-serif">
          Déconnecter
        </button>
      </div>

      <!-- Stats rapides -->
      <div style="display:grid;grid-template-columns:1fr 1fr 1fr;gap:10px;margin-bottom:20px">
        <div style="background:#1e293b;border:1px solid #334155;border-radius:16px;padding:14px;text-align:center">
          <p id="stat-offers" style="font-size:24px;font-weight:900;color:#f97316">0</p>
          <p style="font-size:10px;color:#64748b;font-weight:700">OFFRES</p>
        </div>
        <div style="background:#1e293b;border:1px solid #334155;border-radius:16px;padding:14px;text-align:center">
          <p id="stat-views" style="font-size:24px;font-weight:900;color:#34d399">0</p>
          <p style="font-size:10px;color:#64748b;font-weight:700">VUES</p>
        </div>
        <div style="background:#1e293b;border:1px solid #334155;border-radius:16px;padding:14px;text-align:center">
          <p id="stat-saved" style="font-size:24px;font-weight:900;color:#6ee7b7">0kg</p>
          <p style="font-size:10px;color:#64748b;font-weight:700">CO₂ ÉVITÉ</p>
        </div>
      </div>

      <!-- Bouton nouvelle offre -->
      <button onclick="showNewOfferPanel()" style="width:100%;padding:18px;background:linear-gradient(135deg,#f97316,#ea580c);color:white;border:none;border-radius:18px;font-size:17px;font-weight:900;cursor:pointer;font-family:Montserrat,sans-serif;box-shadow:0 8px 24px rgba(249,115,22,0.35);margin-bottom:20px;display:flex;align-items:center;justify-content:center;gap:10px">
        <span style="font-size:22px">⚡</span> Nouvelle offre flash
      </button>

      <!-- Panel nouvelle offre (photo + vocal) -->
      <div id="new-offer-panel" style="display:none;background:#1e293b;border:1px solid #334155;border-radius:24px;padding:18px;margin-bottom:20px">
        <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:16px">
          <h3 style="font-size:16px;font-weight:900">Créer une offre</h3>
          <button onclick="hideNewOfferPanel()" style="background:#0f172a;border:none;border-radius:8px;padding:6px 10px;color:#64748b;cursor:pointer;font-size:18px">✕</button>
        </div>

        <!-- Photo -->
        <div style="margin-bottom:14px">
          <p style="font-size:11px;color:#64748b;font-weight:700;margin-bottom:8px">1 · PHOTO DU PRODUIT</p>
          <div id="dash-photo-zone" style="width:100%;height:160px;background:#0f172a;border:2px dashed #334155;border-radius:14px;display:flex;align-items:center;justify-content:center;cursor:pointer;position:relative;overflow:hidden" onclick="document.getElementById('dash-cam-input').click()">
            <div id="dash-photo-placeholder" style="text-align:center;color:#475569">
              <div style="font-size:36px">📷</div>
              <p style="font-size:13px;margin-top:6px;font-weight:600">Appuyez pour photographier</p>
            </div>
            <img id="dash-photo-img" style="display:none;width:100%;height:100%;object-fit:cover;position:absolute;inset:0" />
            <div id="dash-ai-scanning" style="display:none;position:absolute;inset:0;background:rgba(0,0,0,0.7);align-items:center;justify-content:center;flex-direction:column;gap:8px">
              <div style="width:40px;height:40px;border:3px solid #f97316;border-top-color:transparent;border-radius:50%;animation:spin 0.8s linear infinite"></div>
              <p style="color:white;font-size:13px;font-weight:700">Analyse IA...</p>
            </div>
          </div>
          <input type="file" id="dash-cam-input" accept="image/*" capture="environment" style="display:none" onchange="handleDashPhoto(event)" />
          <div style="display:flex;gap:8px;margin-top:8px">
            <button onclick="document.getElementById('dash-cam-input').click()" style="flex:1;padding:10px;background:#f97316;color:white;border:none;border-radius:10px;font-weight:700;font-size:13px;cursor:pointer;font-family:Montserrat,sans-serif">📷 Caméra</button>
            <button onclick="document.getElementById('dash-cam-input').removeAttribute('capture');document.getElementById('dash-cam-input').click()" style="flex:1;padding:10px;background:#0f172a;color:#94a3b8;border:1px solid #334155;border-radius:10px;font-weight:700;font-size:13px;cursor:pointer;font-family:Montserrat,sans-serif">🖼 Galerie</button>
          </div>
          <div id="dash-ai-result" style="display:none;background:rgba(16,185,129,0.1);border:1px solid rgba(16,185,129,0.3);border-radius:10px;padding:10px;margin-top:8px;font-size:12px;color:#6ee7b7;font-weight:600"></div>
        </div>

        <!-- Vocal -->
        <div style="margin-bottom:14px">
          <p style="font-size:11px;color:#64748b;font-weight:700;margin-bottom:8px">2 · NOTE VOCALE <span style="color:#475569;font-weight:400">(Chrome requis)</span></p>
          <div style="display:flex;align-items:center;gap:12px">
            <button id="dash-mic-btn" onclick="toggleDashMic()" style="width:64px;height:64px;border-radius:50%;background:#f97316;border:none;cursor:pointer;font-size:26px;flex-shrink:0;box-shadow:0 4px 16px rgba(249,115,22,0.4);transition:all 0.2s">🎤</button>
            <div style="flex:1">
              <p id="dash-mic-hint" style="font-size:13px;color:#64748b;font-weight:600">Produit, quantité, prix, remise</p>
              <p id="dash-transcript" style="font-size:13px;color:#e2e8f0;font-style:italic;margin-top:4px;min-height:18px"></p>
            </div>
          </div>
        </div>

        <!-- Champs manuels -->
        <div style="margin-bottom:14px">
          <p style="font-size:11px;color:#64748b;font-weight:700;margin-bottom:8px">3 · DÉTAILS <span style="color:#475569;font-weight:400">(vérifiez et corrigez)</span></p>
          <div style="display:flex;flex-direction:column;gap:8px">
            <input id="dash-name" placeholder="Nom du produit *" style="width:100%;background:#0f172a;border:1px solid #334155;border-radius:10px;padding:12px;color:white;font-family:Montserrat,sans-serif;font-size:14px" />
            <div style="display:grid;grid-template-columns:1fr 1fr 1fr;gap:8px">
              <div>
                <p style="font-size:10px;color:#64748b;font-weight:700;margin-bottom:4px">PRIX BASE €</p>
                <input id="dash-orig" type="number" step="0.01" oninput="calcDashFlash()" placeholder="0" style="width:100%;background:#0f172a;border:1px solid #334155;border-radius:10px;padding:10px;color:white;font-family:Montserrat,sans-serif;font-size:14px" />
              </div>
              <div>
                <p style="font-size:10px;color:#64748b;font-weight:700;margin-bottom:4px">REMISE %</p>
                <input id="dash-discount" type="number" oninput="calcDashFlash()" placeholder="0" style="width:100%;background:#0f172a;border:1px solid #334155;border-radius:10px;padding:10px;color:white;font-family:Montserrat,sans-serif;font-size:14px" />
              </div>
              <div>
                <p style="font-size:10px;color:#64748b;font-weight:700;margin-bottom:4px">QUANTITÉ</p>
                <input id="dash-qty" placeholder="100kg" style="width:100%;background:#0f172a;border:1px solid #334155;border-radius:10px;padding:10px;color:white;font-family:Montserrat,sans-serif;font-size:14px" />
              </div>
            </div>
            <!-- Flash price preview -->
            <div id="dash-flash-preview" style="display:none;background:rgba(16,185,129,0.1);border:1px solid rgba(16,185,129,0.3);border-radius:10px;padding:10px;display:flex;justify-content:space-between;align-items:center">
              <span style="color:#6ee7b7;font-size:13px;font-weight:700">Prix flash :</span>
              <span id="dash-flash-val" style="font-size:22px;font-weight:900;color:#34d399"></span>
            </div>
            <!-- Category -->
            <div style="display:flex;gap:6px;flex-wrap:wrap">
              <button onclick="setDashCat(this,'viande')" class="dash-cat-btn" style="padding:8px 12px;background:rgba(239,68,68,0.15);border:1px solid rgba(239,68,68,0.3);border-radius:10px;color:#fca5a5;font-size:12px;font-weight:700;cursor:pointer;font-family:Montserrat,sans-serif">🥩 Viande</button>
              <button onclick="setDashCat(this,'cave')" class="dash-cat-btn" style="padding:8px 12px;background:rgba(139,92,246,0.15);border:1px solid rgba(139,92,246,0.3);border-radius:10px;color:#c4b5fd;font-size:12px;font-weight:700;cursor:pointer;font-family:Montserrat,sans-serif">🍷 Cave</button>
              <button onclick="setDashCat(this,'primeur')" class="dash-cat-btn" style="padding:8px 12px;background:rgba(16,185,129,0.15);border:1px solid rgba(16,185,129,0.3);border-radius:10px;color:#6ee7b7;font-size:12px;font-weight:700;cursor:pointer;font-family:Montserrat,sans-serif">🥦 Primeur</button>
              <button onclick="setDashCat(this,'laitier')" class="dash-cat-btn" style="padding:8px 12px;background:rgba(234,179,8,0.15);border:1px solid rgba(234,179,8,0.3);border-radius:10px;color:#fde68a;font-size:12px;font-weight:700;cursor:pointer;font-family:Montserrat,sans-serif">🧀 Laitier</button>
              <button onclick="setDashCat(this,'pret')" class="dash-cat-btn" style="padding:8px 12px;background:rgba(59,130,246,0.15);border:1px solid rgba(59,130,246,0.3);border-radius:10px;color:#93c5fd;font-size:12px;font-weight:700;cursor:pointer;font-family:Montserrat,sans-serif">🍱 Prêt</button>
              <button onclick="setDashCat(this,'poisson')" class="dash-cat-btn" style="padding:8px 12px;background:rgba(6,182,212,0.15);border:1px solid rgba(6,182,212,0.3);border-radius:10px;color:#67e8f9;font-size:12px;font-weight:700;cursor:pointer;font-family:Montserrat,sans-serif">🐟 Poisson</button>
            </div>
            <input type="hidden" id="dash-cat" value="pret" />
          </div>
        </div>

        <button onclick="publishDashOffer()" style="width:100%;padding:16px;background:#f97316;color:white;border:none;border-radius:14px;font-size:16px;font-weight:900;cursor:pointer;font-family:Montserrat,sans-serif;box-shadow:0 6px 20px rgba(249,115,22,0.3)" id="dash-publish-btn">
          ⚡ Publier dans le feed
        </button>
      </div>

      <!-- Mes offres sauvegardées -->
      <div>
        <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:12px">
          <h3 style="font-size:15px;font-weight:900">Mes offres</h3>
          <span id="my-offers-count" style="font-size:12px;color:#64748b"></span>
        </div>
        <div id="merchant-offers-list"></div>
      </div>
    </div>
  </div>


  <!-- SPLASH SCREEN -->
  <div id="splash-screen" style="position:fixed;inset:0;background:linear-gradient(160deg,#0f172a 0%,#1a2744 50%,#0f2318 100%);z-index:9999;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:0;transition:opacity 0.6s ease">
    <!-- Animated rings -->
    <div style="position:absolute;width:280px;height:280px;border-radius:50%;border:2px solid rgba(249,115,22,0.15);animation:splashRing 2s ease-out infinite"></div>
    <div style="position:absolute;width:340px;height:340px;border-radius:50%;border:1px solid rgba(16,185,129,0.1);animation:splashRing 2s ease-out 0.4s infinite"></div>

    <!-- Logo -->
    <div style="position:relative;animation:splashLogo 0.8s cubic-bezier(0.34,1.56,0.64,1) forwards;opacity:0;transform:scale(0.5)">
      <img src="logo.png" style="width:200px;height:200px;object-fit:contain;filter:drop-shadow(0 0 30px rgba(249,115,22,0.4))" />
    </div>

    <!-- Slogan -->
